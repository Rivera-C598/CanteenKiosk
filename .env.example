# Copy this file to .env and fill in the values.
# Never commit .env — it contains secrets.

# SQLite database path (leave as-is for local deployment)
DATABASE_URL="file:./dev.db"

# IP address of the KIOSK device (tablet/PC running the order screen)
# Leave blank to disable IP lock (useful during setup/testing)
# Set to the KIOSK device's LAN IP, e.g. 192.168.1.50
# Localhost (127.0.0.1) always bypasses this lock automatically
KIOSK_IP=

# PIN for kitchen staff to access /kitchen
# Change from the default before going live
KITCHEN_PIN=1234

# Set to true in development to show reset/demo buttons in admin
# Set to false (or remove) in production
ENABLE_DANGER_ZONE=false

# Session encryption key — REQUIRED, must be 32+ characters
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# App will crash on startup if this is missing or too short
SESSION_SECRET=replace-this-with-a-random-64-char-hex-string-from-the-command-above
